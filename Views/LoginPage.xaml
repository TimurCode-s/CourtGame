<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtGame.Views.LoginPage"
             Title="LoginPage">
    <VerticalStackLayout>
        <Label Text="UserNameee"></Label>
        <Entry x:Name="Name" Placeholder="Enter your username" />
        <Label Text="Passworde"></Label>
        <Entry x:Name="Password" Placeholder="Enter your password" />
        <Button Text="Log in" Clicked="OnLoginClicked" />
    </VerticalStackLayout>
</ContentPage>