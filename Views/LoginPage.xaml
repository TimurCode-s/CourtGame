<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtGame.Views.LoginPage"
             Title="LoginPage">
    <Grid>
        <!-- Courtroom background -->
        <Image
        Source="back_ground.png"
        Aspect="AspectFill" />

        <!-- Dark overlay -->
        <BoxView Color="#70301B12" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <Grid Padding="16,24"
              HorizontalOptions="Fill">

                <Border
                BackgroundColor="#E82F1D16"
                Stroke="#8C6049"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28"
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="520"
                MaximumWidthRequest="600">

                    <VerticalStackLayout Spacing="14">

                        <!-- Header -->
                        <Label
                        Text="⚖"
                        FontSize="42"
                        HorizontalTextAlignment="Center"
                        TextColor="#FFB64F" />

                        <Label
                        Text="Log into your Account"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#FFF3E7" />

                        <Label
                        Text="Let's continue your journey"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="#C8B5A5"
                        Margin="0,0,0,8" />

                        <!-- Name -->
                        <VerticalStackLayout Spacing="4">
                            <Border
                            Stroke="#8C6049"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 28"
                            Padding="16,5">

                                <Entry
                                x:Name="Name"
                                Placeholder="♙   Name"
                                TextColor="#FFF3E7"
                                PlaceholderColor="#C8B5A5"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing" />
                                
                            </Border>

                            <Label
                            x:Name="NameErr"
                            Text="Name is required."
                            TextColor="#FFFF7777"
                            FontSize="12"
                            Margin="12,0,0,0"
                            IsVisible="False" />
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="4">
                            <Border
                            Stroke="#8C6049"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 28"
                            Padding="16,5">

                                <Entry
                                x:Name="EmailEntry"
                                Placeholder="✉   Email"
                                Keyboard="Email"
                                TextColor="#FFF3E7"
                                PlaceholderColor="#C8B5A5"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing" />
                            </Border>

                            <Label
                            x:Name="EmailErr"
                            Text="Please enter a valid email address."
                            TextColor="#FFFF7777"
                            FontSize="12"
                            Margin="12,0,0,0"
                            IsVisible="False" />
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout Spacing="4">
                            <Border
                            Stroke="#8C6049"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 28"
                            Padding="16,5">

                                <Entry
                                x:Name="Password"
                                Placeholder="♙   Password"
                                IsPassword="True"
                                TextColor="#FFF3E7"
                                PlaceholderColor="#C8B5A5"
                                BackgroundColor="Transparent" />
                            </Border>

                            <Label
                            x:Name="PassErr"
                            Text="Password must contain at least 8 characters."
                            TextColor="#FFFF7777"
                            FontSize="12"
                            Margin="12,0,0,0"
                            IsVisible="False" />
                        </VerticalStackLayout>
                        <Label Text="You not have an account?" TextColor="White" HorizontalOptions="Center"></Label>
                        <Button Clicked="OnRegisterClicked" Text="Regist" BackgroundColor="Transparent" Style="{x:StaticResource Tranbutt}"></Button>

                        <!-- Log in -->
                        <Button      
                        Text="Log in"
                        Clicked="OnLoginClicked"
                        BackgroundColor="#FFB64F"
                        TextColor="#402518"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="28"
                        HeightRequest="52"
                        Margin="0,4,0,0" 
                        Style="{x:StaticResource MK}"
                        />

                        <BoxView
                        HeightRequest="1"
                        Color="#8C6049"
                        Margin="0,2,0,0" />

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>