<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtGame.Views.RegisterPage"
             Title="RegisterPage">
    <VerticalStackLayout>
        <Label Text="UserNameee"></Label>
        <Entry x:Name="UserNameEntry" Placeholder="Enter your username" />
        <Label Text="Passworde"></Label>
        <Entry x:Name="Password" Placeholder="Enter your password" />
        <Button Text="Register" Clicked="OnRegisterClicked" />
    </VerticalStackLayout>
</ContentPage>