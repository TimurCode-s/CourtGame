<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtGame.Views.HomePage"
             Title="HomePage">
    <Grid RowDefinitions="*, *, *" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="500" HeightRequest="300" RowSpacing="25">
        
        <Button Clicked="Start_Button" Text="Start" Grid.Row="0" BackgroundColor="Aqua"></Button>

        <Button Clicked="Option_Button" Text="Option" Grid.Row="1" BackgroundColor="Aqua"></Button>

        <Button Clicked="Exit_Button" Text="Exit" Grid.Row="2" BackgroundColor="Aqua"></Button>
       
    </Grid>
</ContentPage>