<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtGame.Views.LevelPageMaster"
             Title="LevelPageMaster">
    <Grid>
        <Image Source="court_room.png" Aspect="AspectFill" ></Image>

        
        <AbsoluteLayout>
            <CollectionView ItemsSource="{Binding Case.Images}">
                <CollectionView.EmptyView>
                    <Label Text="No cases available, maybe something happened with binding. Call to Eldan :)" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Image Source="{Binding images}" 
                                    />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>



            </CollectionView>

            <Image Source="lawyer.png"
           Aspect="AspectFit"
           AbsoluteLayout.LayoutBounds="0.15,0.46,0.12,0.2"
           AbsoluteLayout.LayoutFlags="All" />

            <Image Source="suspect.png"
           Aspect="AspectFit"
           AbsoluteLayout.LayoutBounds="0.33,0.46,0.12,0.2"
           AbsoluteLayout.LayoutFlags="All" />

            <Image Source="prosecutor.png"
           Aspect="AspectFit"
           AbsoluteLayout.LayoutBounds="0.68,0.46,0.12,0.2"
           AbsoluteLayout.LayoutFlags="All" />

        </AbsoluteLayout>
    </Grid>
</ContentPage>