<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CourtGame.Views.LevelPageMaster"
             Title="LevelPageMaster">
    <Grid>
        <Image Source="courtroom.png" Aspect="AspectFill" ></Image>

        <AbsoluteLayout>

            <ImageButton Source="{Binding Images[0]}"
                Aspect="AspectFit"
                AbsoluteLayout.LayoutBounds="0.15,0.46,0.12,0.2"
                AbsoluteLayout.LayoutFlags="All" 
                BackgroundColor="Transparent" />

            <ImageButton Source="{Binding Images[1]}"
                Aspect="AspectFit"
                AbsoluteLayout.LayoutBounds="0.33,0.46,0.12,0.2"
                AbsoluteLayout.LayoutFlags="All" 
                BackgroundColor="Transparent"/>

            <ImageButton Source="{Binding Images[2]}"
                Aspect="AspectFit"
                AbsoluteLayout.LayoutBounds="0.68,0.46,0.12,0.2"
                AbsoluteLayout.LayoutFlags="All" 
                BackgroundColor="Transparent"/>
            
            <ImageButton Source="micro.png"
                Style="{StaticResource MMD}"
                Aspect="AspectFit"
                AbsoluteLayout.LayoutBounds="0.5,0.9,0.12,0.45"
                AbsoluteLayout.LayoutFlags="All" 
                BackgroundColor="Transparent"
                Command="{Binding MicroCommand}" />

        </AbsoluteLayout>
        <Grid VerticalOptions="End"
            HorizontalOptions="Fill"
            HeightRequest="350"
            WidthRequest="1000"
            Margin="25,0,25,20"
            IsVisible="{Binding Visible}">

            
            <ImageButton Source="dialogwindow.png" Aspect="Fill" BackgroundColor="Transparent" Command="{Binding DialogCommmand}"/>

            <!-- Dialogue text -->
            <Label Text="{Binding DialogText}"
                 TextColor="#211711"
                 FontSize="20"
                 Margin="35,20,65,20"
                 VerticalOptions="Center"
                 HorizontalOptions="Start" 
                 />   

        </Grid>
    </Grid>
</ContentPage>