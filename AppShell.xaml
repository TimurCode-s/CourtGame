<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CourtGame.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CourtGame.Views"
    Shell.FlyoutBehavior="Locked"
    Title="CourtGame">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:HomePage}"
        Route="MainPage" />

    <ShellContent
        Title="Option"
        ContentTemplate="{DataTemplate local:OptionPage}" />

    <ShellContent
        Title="Levels"
        ContentTemplate="{DataTemplate local:Lo}" />

    


</Shell>
